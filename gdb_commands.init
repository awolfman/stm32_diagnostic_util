target remote :3333

# Аппаратная остановка ядра и сброс периферии
monitor reset halt

# Загрузка прошивки в SRAM
load

# Старт выполнения из SRAM (адрес 0x20000000).
# Вся дальнейшая инициализация регистров выполняется кодом Reset_Handler в main.c.
set $msp = 0x2000C000
set $sp = 0x2000C000
set $pc = Reset_Handler
set {unsigned int}0xE000ED08 = 0x20000000

# Включаем текстовый вывод (Semihosting)
monitor arm semihosting enable

# ====================================================================
# Вывод статуса пинов и переменных
# ====================================================================
define show_status
  printf "\n=== СТАТУС СИСТЕМЫ И ПЕРИФЕРИИ ===\n"
  set $idr_a = *(volatile unsigned int *)(0x48000000 + 0x10)
  set $idr_b = *(volatile unsigned int *)(0x48000400 + 0x10)

  printf "Пин PA10 (LTM4678): %s\n", ($idr_a & (1 << 10)) ? "HIGH (1) [OK]" : "LOW (0) [FAIL]"
  printf "Пин PB7  (LTM4673): %s\n", ($idr_b & (1 << 7))  ? "HIGH (1) [OK]" : "LOW (0) [FAIL]"
  printf "Пин PB0  (ALARM_IPM): %s\n", ($idr_b & (1 << 0))  ? "HIGH (1) [FAIL]" : "LOW (0) [OK]"
  printf "Пин PB1  (THERM):     %s\n", ($idr_b & (1 << 1))  ? "HIGH (1)" : "LOW (0)"
  printf "Пин PB6  (PLL_LOCKED):%s\n", ($idr_b & (1 << 6))  ? "HIGH (1) [FAIL]" : "LOW (0) [OK]"

  printf "--- Сигналы управления CPU T2081 ---\n"
  printf "Пин PB3  (RESET_REQ): %s, status_RESET_REQ=%d\n", ($idr_b & (1 << 3)) ? "HIGH [OK]" : "LOW [ЗАПРОС АКТИВЕН]", status_RESET_REQ
  printf "Пин PB5  (CKSTP):     %s, status_CKSTP=%d\n", ($idr_b & (1 << 5)) ? "HIGH [OK]" : "LOW [CHECKSTOP]", status_CKSTP
  printf "cpu_boot_stage: %d\n", cpu_boot_stage
#  printf "status_PLL_LOCK_TIMEOUT: %d\n", status_PLL_LOCK_TIMEOUT

  printf "--- Состояния на шине SPI STM32 ---\n"
  printf "PA4  (I2C_EN/HRESET): %d\n", ($idr_a & (1 << 4)) ? 1 : 0
  printf "PA5  (CLK):  %d\n", ($idr_a & (1 << 5)) ? 1 : 0
  printf "PA6  (MISO): %d\n", ($idr_a & (1 << 6))  ? 1 : 0
  printf "PA12 (MOSI): %d\n", ($idr_a & (1 << 12)) ? 1 : 0
  printf "PA15 (CS):   %d\n", ($idr_a & (1 << 15)) ? 1 : 0
  printf "----------------------------------\n"
  printf "Переменная flash_jedec_id:  0x%08X\n", flash_jedec_id
  printf "Список I2C устройств:        %s\n", (char*)&i2c_devices_list
  printf "==================================\n\n"
end

define hook-stop
  show_status
end

printf "\n[GDB] Готово к тесту. Запустите программу командой 'c' (continue).\n"
printf "[GDB] Через 10-15 секунд остановите её вручную через Ctrl+C и введите 'show_status'.\n"
